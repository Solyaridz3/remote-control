        <desktop:Extension Category="windows.startupTask" Executable="RemoteController.Startup.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="RemoteStartup" Enabled="false" DisplayName="PocketPointer" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
